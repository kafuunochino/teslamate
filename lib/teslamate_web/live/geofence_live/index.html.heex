<nav class="breadcrumb" aria-label={gettext("Breadcrumbs")}>
  <ul>
    <li><.link navigate={~p"/"}><%= gettext("Home") %></.link></li>
    <li class="is-active">
      <.link navigate={~p"/admin/geo-fences"}><%= gettext("Geo-Fences") %></.link>
    </li>
  </ul>
</nav>

<header class="page-heading geofence-heading">
  <div>
    <p class="page-kicker">常用地点与充电计费</p>
    <h1>地理围栏</h1>
    <p>
      为家、公司或常用充电站划定范围。行程起点、终点和充电记录落在范围内时，会显示你设置的地点名称；还可设置该地点的充电计费规则。
    </p>
  </div>
  <.link
    navigate={Routes.live_path(@socket, TeslaMateWeb.GeoFenceLive.Form)}
    class="button is-info"
  >
    <span class="icon"><span class="mdi mdi-plus"></span></span>
    <span><%= gettext("Create") %></span>
  </.link>
</header>

<%= if @geofences == [] do %>
  <p class="geofence-empty">还没有地理围栏。点击“新建”，在地图上选择地点并设置范围。</p>
<% end %>

<div class="responsive-table">
  <table class="table is-fullwidth">
    <thead>
      <tr>
        <th><%= gettext("Name") %></th>
        <th><%= gettext("Position") %></th>
        <th><%= gettext("Radius") %></th>
        <th></th>
      </tr>
    </thead>
    <tbody style="font-variant-numeric: tabular-nums;">
      <%= for geofence <- @geofences do %>
        <tr>
          <td data-label="名称" class="has-text-weight-medium">
            <%= geofence.name %>
          </td>
          <td data-label="位置" class="has-text-weight-light">
            <%= geofence.latitude %>, <%= geofence.longitude %>
          </td>
          <td data-label="半径" class="has-text-weight-light">
            <%= case @unit_of_length do
              :ft -> geofence.radius |> Convert.m_to_ft() |> round()
              :m -> geofence.radius |> round()
            end %> <%= @unit_of_length %>
          </td>
          <td data-label="操作">
            <div class="field is-grouped is-pulled-right">
              <p class="control">
                <.link
                  navigate={
                    Routes.live_path(@socket, TeslaMateWeb.GeoFenceLive.Form, geofence, [])
                  }
                  class="button is-info is-small is-inverted is-light"
                >
                  <span class="icon"><span class="mdi mdi-square-edit-outline"></span></span>
                </.link>
              </p>
              <p class="control">
                <%= link(raw("<span class='icon'><span class='mdi mdi-trash-can'></span></span>"),
                  to: "#",
                  phx_hook: "ConfirmGeoFenceDeletion",
                  data: [
                    id: geofence.id,
                    msg: gettext("Delete '%{geo_fence}'?", geo_fence: geofence.name)
                  ],
                  type: "button",
                  id: "delete_#{geofence.id}",
                  class: "button is-danger is-small is-inverted is-light"
                ) %>
              </p>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

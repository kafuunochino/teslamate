<div id="battery-dashboard" class="platform-page battery-dashboard" phx-hook="DrivingDashboard">
  <header class="page-heading">
    <div>
      <p class="page-kicker">电池状态与长期变化</p>
      <h1>电池</h1>
      <p>电量、续航、模组温度与容量趋势。</p>
    </div>
    <.vehicle_picker
      :if={@report && @report.cars != []}
      cars={@report.cars}
      current_car={@report.car}
    />
  </header>
  <.no_vehicle :if={@report && !@report.car} admin={TeslaMate.Accounts.admin?(@current_user)} />
  <div class="drive-disconnected" role="status">连接已中断，显示的是旧数据，正在尝试重连。</div>
  <p :if={@battery_error} class="drive-notice" role="status">暂时无法读取数据，正在等待重新连接。</p>

  <%= if @report && @report.car do %>
    <div class="battery-toolbar">
      <span>每 5 秒刷新已有采样 · 休眠时展示最近记录，不唤醒车辆</span>
      <button type="button" id="battery-refresh-now" class="button" phx-click="refresh_battery">
        <i class="mdi mdi-refresh" aria-hidden="true"></i> 刷新
      </button>
    </div>
    <.battery_panel data={@report.battery_data} />
    <.range_picker days={@report.days} />
    <% capacity? = @report.history_source != :range_estimate %>
    <% basis =
      case @report.history_source do
        :fleet_capacity -> "官方标称满电能量"
        :fleet_normalized -> "官方剩余能量 / SOC 归一化估算"
        _ -> "额定续航归一化估算"
      end %>
    <section class="metrics-grid">
      <.metric_card
        title={
          if @report.history_source == :fleet_capacity, do: "所选时期的满电能量变化", else: "所选时期的容量变化估算"
        }
        value={
          if @report.degradation, do: percentage(@report.degradation.loss_percent), else: "数据不足"
        }
        hint="正值表示下降、负值表示回升；不是出厂衰减率或官方 SOH"
        icon="battery-heart-variant"
        tone="amber"
      />
      <.metric_card
        title="趋势数据来源"
        value={basis}
        hint="同一曲线使用相同口径，不混合容量与续航基线"
        icon="chart-line"
        tone="cyan"
      />
      <.metric_card
        title="电池类型"
        value={if @report.car.settings.lfp_battery, do: "LFP", else: "未标记为 LFP"}
        hint="来自车辆设置，不通过电量或续航反推"
        icon="car-battery"
        tone="slate"
      />
    </section>
    <p id="battery-capacity-source" class="drive-method">
      <%= case @report.history_source do %>
        <% :fleet_capacity -> %>
          使用车辆直接上报的标称满电能量，按日取中位数。至少 7 个有效采样日后比较初期与近期；变化可能受温度和 BMS 校准影响。
        <% :fleet_normalized -> %>
          已收到电池剩余能量，但尚无标称满电能量历史。当前使用同次采样的剩余能量和 SOC 归一化估算，仅采用 20%～95% 电量样本；至少 7 个有效采样日后比较变化。
        <% _ -> %>
          当前缺少可用于容量趋势的电池历史采样，暂用归一化额定续航。新采样会逐步积累，历史行程不会使用当前电池读数重算。
      <% end %>
      <span :if={@report.history_source != :fleet_capacity}>
        标称满电能量需要车辆软件 2026.32 或更新版本支持，并启用相应遥测字段；绑定钥匙不会使车辆自动提供不支持的字段。
      </span>
    </p>
    <section :if={@report.degradation} class="data-card degradation-card">
      <div class="data-card__header">
        <div>
          <p class="section-kicker">长期趋势</p>
          <h2><%= basis %></h2>
        </div>
        <span>比较所选时期，不等同于电池健康检测</span>
      </div>
      <div class="degradation-comparison">
        <div>
          <span>时间范围初期</span><strong><%= if capacity?, do: energy(@report.degradation.baseline, 2), else: distance(@report.degradation.baseline) %></strong>
        </div>
        <i class="mdi mdi-arrow-right" aria-hidden="true"></i>
        <div>
          <span>时间范围近期</span><strong><%= if capacity?, do: energy(@report.degradation.current, 2), else: distance(@report.degradation.current) %></strong>
        </div>
      </div>
    </section>
    <.bar_chart
      title={
        case @report.history_source do
          :fleet_capacity -> "每日电池包满电能量"
          :fleet_normalized -> "每日满电能量估算"
          _ -> "每日归一化满电额定续航"
        end
      }
      rows={@report.history}
      unit={if capacity?, do: " kWh", else: " km"}
      empty="当前范围内缺少有效样本"
    />
    <div class="drive-shortcuts">
      <.link navigate={Routes.dashboard_path(@socket, :driving, car: @report.car.id)}>
        <i class="mdi mdi-engine"></i> 驱动系统与座舱
      </.link>
      <.link navigate={Routes.dashboard_path(@socket, :charging, car: @report.car.id)}>
        <i class="mdi mdi-ev-station"></i> 充电与损耗
      </.link>
    </div>
  <% end %>
</div>

<div class="platform-page">
  <header class="page-heading">
    <div>
      <p class="page-kicker">车辆数据中心</p>
      <h1>首页总览</h1>
      <p>实时状态与最近 30 天关键数据集中呈现。</p>
    </div>
    <.vehicle_picker :if={@report.cars != []} cars={@report.cars} current_car={@report.car} />
  </header>

  <.no_vehicle :if={!@report.car} admin={TeslaMate.Accounts.admin?(@current_user)} />

  <%= if @report.car do %>
    <% live = @report.live %>
    <% position = @report.position %>
    <% battery = (live && live.battery_level) || (position && position.battery_level) %>
    <% range =
      (live && live.rated_battery_range_km) || (position && position.rated_battery_range_km) %>
    <% odometer = (live && live.odometer) || (position && position.odometer) %>
    <% elevation = (live && live.elevation) || (position && position.elevation) %>
    <% latitude = (live && live.latitude) || (position && position.latitude) %>
    <% longitude = (live && live.longitude) || (position && position.longitude) %>

    <section class="vehicle-hero">
      <div class="vehicle-hero__identity">
        <span class="vehicle-hero__icon"><i class="mdi mdi-car-electric"></i></span>
        <div>
          <p class="vehicle-hero__meta">VIN · <%= TeslaMate.Fleet.vin_suffix(@report.car) %></p>
          <h2><%= TeslaMate.Fleet.vehicle_label(@report.car) %></h2>
          <p>
            <span class="status-dot"></span>
            <%= state_label(live || @report.state) %>
            <span :if={position}>· 最后数据 <%= date_time(position.date) %></span>
          </p>
        </div>
      </div>
      <div class="vehicle-hero__battery">
        <div class="battery-gauge" style={"--battery: #{battery || 0}"}>
          <span><%= if battery, do: "#{battery}%", else: "—" %></span>
        </div>
        <div><strong><%= distance(range) %></strong><small>预计额定续航</small></div>
      </div>
    </section>

    <section class="metrics-grid metrics-grid--six" aria-label="车辆实时指标">
      <.metric_card
        title="当前电量"
        value={if battery, do: "#{battery}%", else: "—"}
        icon="battery-high"
        tone="green"
      />
      <.metric_card
        title="预计续航"
        value={distance(range)}
        icon="map-marker-distance"
        tone="blue"
      />
      <.metric_card title="累计里程" value={distance(odometer)} icon="counter" tone="violet" />
      <.metric_card
        title="当前海拔"
        value={if elevation, do: "#{elevation} m", else: "—"}
        icon="image-filter-hdr"
        tone="amber"
      />
      <.metric_card
        title="车外温度"
        value={temperature((live && live.outside_temp) || (position && position.outside_temp))}
        icon="thermometer"
        tone="cyan"
      />
      <.metric_card
        title="软件版本"
        value={(live && live.version) || (@report.update && @report.update.version) || "—"}
        icon="update"
        tone="slate"
      />
    </section>

    <div class="content-grid content-grid--map">
      <section class="data-card location-card">
        <div class="data-card__header">
          <div>
            <p class="section-kicker">实时位置</p>
            <h2><%= TeslaMate.Fleet.address_label(@report.location) %></h2>
          </div>
          <span class="privacy-badge"><i class="mdi mdi-shield-lock-outline"></i> 仅授权账号可见</span>
        </div>
        <div
          :if={latitude && longitude}
          id="home-vehicle-map"
          class="platform-map"
          phx-hook="PlatformMap"
          phx-update="ignore"
          data-points={Jason.encode!([%{latitude: latitude, longitude: longitude}])}
          data-mode="point"
        >
        </div>
        <div :if={!latitude || !longitude} class="empty-inline">暂无可显示的位置坐标</div>
        <p :if={latitude && longitude} class="coordinate-line">
          <i class="mdi mdi-crosshairs-gps"></i>
          <%= format_number(latitude, 5) %>, <%= format_number(longitude, 5) %>
        </p>
      </section>

      <section class="data-card quick-stats">
        <div class="data-card__header">
          <div>
            <p class="section-kicker">最近 30 天</p>
            <h2>使用概览</h2>
          </div>
        </div>
        <dl>
          <div>
            <dt>行程</dt>
            <dd><%= @report.drive_stats.count %> 次</dd>
          </div>
          <div>
            <dt>行驶距离</dt>
            <dd><%= distance(@report.drive_stats.distance) %></dd>
          </div>
          <div>
            <dt>驾驶时长</dt>
            <dd><%= duration(@report.drive_stats.duration_min) %></dd>
          </div>
          <div>
            <dt>充电</dt>
            <dd><%= @report.charge_stats.count %> 次</dd>
          </div>
          <div>
            <dt>充入电量</dt>
            <dd><%= energy(@report.charge_stats.energy_added) %></dd>
          </div>
          <div>
            <dt>充电费用</dt>
            <dd><%= money(@report.charge_stats.cost) %></dd>
          </div>
        </dl>
      </section>
    </div>

    <.bar_chart title="近 14 天每日行驶里程" rows={@report.daily_distance} unit=" km" />

    <div class="content-grid">
      <section class="data-card">
        <div class="data-card__header">
          <h2>最近行程</h2>
          <.link navigate={Routes.dashboard_path(@socket, :trips, car: @report.car.id)}>
            查看全部
          </.link>
        </div>
        <div :if={@report.recent_drives == []} class="empty-inline">暂无完整行程</div>
        <div class="activity-list">
          <.link
            :for={drive <- @report.recent_drives}
            navigate={Routes.dashboard_path(@socket, :trip, drive.id)}
            class="activity-item"
          >
            <span class="activity-item__icon"><i class="mdi mdi-map-marker-path"></i></span>
            <span class="activity-item__body">
              <strong>
                <%= location_label(drive.start_geofence || drive.start_address) %> → <%= location_label(
                  drive.end_geofence || drive.end_address
                ) %>
              </strong>
              <small>
                <%= date_time(drive.start_date) %> · <%= duration(drive.duration_min) %>
              </small>
            </span>
            <b><%= distance(drive.distance) %></b>
          </.link>
        </div>
      </section>

      <section class="data-card">
        <div class="data-card__header">
          <h2>最近充电</h2>
          <.link navigate={Routes.dashboard_path(@socket, :charging, car: @report.car.id)}>
            查看全部
          </.link>
        </div>
        <div :if={@report.recent_charges == []} class="empty-inline">暂无充电记录</div>
        <div class="activity-list">
          <div :for={charge <- @report.recent_charges} class="activity-item">
            <span class="activity-item__icon activity-item__icon--charge">
              <i class="mdi mdi-ev-station"></i>
            </span>
            <span class="activity-item__body">
              <strong><%= location_label(charge.geofence || charge.address) %></strong>
              <small>
                <%= date_time(charge.start_date) %> · <%= charge.start_battery_level || "—" %>% → <%= charge.end_battery_level ||
                  "—" %>%
              </small>
            </span>
            <b><%= energy(charge.charge_energy_added) %></b>
          </div>
        </div>
      </section>
    </div>
  <% end %>
</div>

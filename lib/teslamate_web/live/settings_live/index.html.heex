<nav class="breadcrumb" aria-label={gettext("Breadcrumbs")}>
  <ul>
    <li><.link navigate={~p"/"}><%= gettext("Home") %></.link></li>
    <li class="is-active">
      <.link navigate={~p"/admin/settings"}><%= gettext("Settings") %></.link>
    </li>
  </ul>
</nav>

<%= if Enum.count(@car_settings) > 0 do %>
  <%= if Enum.count(@car_settings) > 1 do %>
    <div class="tabs is-centered is-boxed">
      <ul>
        <%= for {car_id, %{original: %{car: car}}} <- @car_settings do %>
          <li class={if car_id == @car, do: "is-active"}>
            <%= link(car.name || "???", to: "#", phx_click: "car", phx_value_id: car_id) %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <.form
    :let={f}
    for={get_in(@car_settings, [@car, :changeset])}
    phx-change="change"
    as={:"car_settings_#{@car}"}
  >
    <div class="columns is-mobile is-centered settings-layout">
      <div class="column">
        <h2 class="title is-4"><%= gettext("Data Collection") %></h2>
        <div class="field is-horizontal center-vertically">
          <div class="field-label is-normal is-paddingless">
            <%= label(f, :enabled, gettext("Enabled"), class: "label") %>
          </div>
          <div class="field-body">
            <div class="field">
              <div class="control">
                <%= checkbox(f, :enabled, class: "switch is-rounded is-success") %>
                <%= label(f, :enabled, nil) %>
              </div>
            </div>
          </div>
        </div>
        <div class="field is-horizontal center-vertically">
          <div class="field-label is-normal">
            <%= label(f, :polling_interval, "采集频率", class: "label") %>
          </div>
          <div class="field-body">
            <div class="field">
              <div class="control">
                <div class="select is-fullwidth">
                  <%= select(
                    f,
                    :polling_interval,
                    Enum.map(CarSettings.polling_intervals(), fn
                      0 -> {"自动（按车辆状态调整）", 0}
                      seconds -> {"每 #{seconds} 秒", seconds}
                    end),
                    aria_describedby: "collection-interval-help"
                  ) %>
                </div>
              </div>
              <p class="help" id="collection-interval-help">
                用于当前车辆在线时的定时采集，下一轮采集起生效。间隔越短，请求越多；页面刷新频率单独设置。
                休眠、离线和接口限流时会自动延长等待，实时推送的数据仍即时接收。
              </p>
              <p class="help is-danger"><%= error_tag(f, :polling_interval) %></p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="columns is-mobile is-centered settings-layout">
      <div class="column">
        <h2 class="title is-4"><%= gettext("Sleep Mode") %></h2>

        <%= unless Ecto.Changeset.get_field(f.source, :use_streaming_api) do %>
          <div class="field is-horizontal center-vertically">
            <div class="field-label is-normal">
              <%= label(f, :suspend_min, gettext("Time to Try Sleeping"), class: "label") %>
            </div>
            <div class="field-body">
              <div class="field">
                <div class="control">
                  <div class="select is-fullwidth">
                    <%= select(
                      f,
                      :suspend_min,
                      (Enum.filter(12..30, &(rem(&1, 3) == 0)) ++
                         Enum.filter(35..90, &(rem(&1, 5) == 0)))
                      |> Enum.map(&{"#{&1} #{gettext("min")}", &1})
                    ) %>
                  </div>
                </div>
                <p class="help is-danger"><%= error_tag(f, :suspend_min) %></p>
              </div>
            </div>
          </div>
          <div class="field is-horizontal center-vertically">
            <div class="field-label is-normal">
              <%= label(f, :suspend_after_idle_min, gettext("Idle Time Before Trying to Sleep"),
                class: "label"
              ) %>
            </div>
            <div class="field-body">
              <div class="field">
                <div class="control">
                  <div class="select is-fullwidth">
                    <%= select(
                      f,
                      :suspend_after_idle_min,
                      3..60
                      |> Enum.filter(&(&1 == 3 or rem(&1, 5) == 0))
                      |> Enum.map(&{"#{&1} #{gettext("min")}", &1})
                    ) %>
                  </div>
                </div>
                <p class="help is-danger"><%= error_tag(f, :suspend_after_idle_min) %></p>
              </div>
            </div>
          </div>
        <% end %>

        <div class="field is-horizontal mb-0">
          <div class="field-label is-normal is-paddingless">
            <label class="label"><%= gettext("Requirements") %></label>
          </div>
          <div class="field-body">
            <div class="field settings-wide-control">
              <div class="control">
                <div class="columns is-multiline is-mobile is-gapless">
                  <div class="column is-full">
                    <label class="checkbox">
                      <%= checkbox(f, :req_not_unlocked) %>&nbsp; <%= gettext(
                        "Vehicle must be locked"
                      ) %>
                    </label>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="columns is-mobile is-centered settings-layout">
      <div class="column">
        <h2 class="title is-4"><%= gettext("Charge cost") %></h2>
        <div class="field is-horizontal center-vertically">
          <div class="field-label is-normal is-paddingless">
            <%= label(f, :free_supercharging, gettext("Free Supercharging"), class: "label") %>
          </div>
          <div class="field-body">
            <div class="field">
              <div class="control">
                <%= checkbox(f, :free_supercharging, class: "switch is-rounded is-success") %>
                <%= label(f, :free_supercharging, nil) %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="columns is-mobile is-centered settings-layout">
      <div class="column">
        <h2 class="title is-4"><%= gettext("Streaming API") %></h2>
        <div class="field is-horizontal center-vertically">
          <div class="field-label is-normal is-paddingless">
            <%= label(f, :use_streaming_api, gettext("Enabled"), class: "label") %>
          </div>
          <div class="field-body">
            <div class="field">
              <div class="control">
                <%= checkbox(f, :use_streaming_api, class: "switch is-rounded is-success") %>
                <%= label(f, :use_streaming_api, nil) %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="columns is-mobile is-centered settings-layout">
      <div class="column">
        <h2 class="title is-4"><%= gettext("Battery") %></h2>
        <div class="field is-horizontal center-vertically">
          <div class="field-label is-normal is-paddingless">
            <%= label(f, :lfp_battery, gettext("LFP Battery"), class: "label") %>
          </div>
          <div class="field-body">
            <div class="field">
              <div class="control">
                <%= checkbox(f, :lfp_battery, class: "switch is-rounded is-success") %>
                <%= label(f, :lfp_battery, nil) %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </.form>
<% end %>

<div class={["divider", if(Enum.count(@car_settings) <= 1, do: " is-invisible")]}>
  <%= gettext("General Settings") %>
</div>

<.form :let={f} for={@global_settings.changeset} phx-change="change">
  <div class="columns is-mobile is-centered settings-layout">
    <div class="column">
      <h2 class="title is-4"><%= gettext("Range") %></h2>
      <div class="field is-horizontal center-vertically">
        <div class="field-label is-normal">
          <%= label f, :preferred_range, class: "label has-tooltip-multiline", data_tooltip: gettext("The car's estimate of remaining range is based on a fixed energy consumption in Wh/km. The Wh/km factor is determined by Tesla and is not country specific whereas the rated range is based on regulatory tests in the different markets for that vehicle.")  do %>
            <%= gettext("Preferred Range") %><span class="icon is-small">&nbsp;<span class="mdi mdi-information"></span></span>
          <% end %>
        </div>
        <div class="field-body">
          <div class="field">
            <div class="control">
              <div class="select is-fullwidth">
                <%= select(f, :preferred_range, [
                  {gettext("ideal"), :ideal},
                  {gettext("rated"), :rated}
                ]) %>
              </div>
            </div>
            <p class="help is-danger"><%= error_tag(f, :preferred_range) %></p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="columns is-mobile is-centered settings-layout">
    <div class="column">
      <h2 class="title is-4"><%= gettext("Language") %></h2>

      <div class="field is-horizontal">
        <div class="field-label is-normal">
          <%= label(f, :ui, gettext("Web App"), class: "label") %>
        </div>
        <div class="field-body">
          <div class="field">
            <div class="control">
              <div class="select is-fullwidth">
                <%= select(f, :ui, supported_ui_languages(), selected: @locale) %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="field is-horizontal">
        <div class="field-label is-normal">
          <%= label(f, :language, gettext("Addresses"), class: "label") %>
        </div>
        <div class="field-body">
          <div class="field">
            <div class="control">
              <div class={["select", "is-fullwidth", if(@refreshing_addresses?, do: "is-loading")]}>
                <%= select(f, :language, supported_address_languages(),
                  disabled: !@addresses_migrated? or @refreshing_addresses?
                ) %>
              </div>
            </div>
            <p class="help is-danger"><%= @refresh_error || error_tag(f, :language) %></p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="columns is-mobile is-centered settings-layout">
    <div class="column">
      <h2 class="title is-4"><%= gettext("Theme") %></h2>
      <div class="field is-horizontal">
        <div class="field-label is-normal">
          <label class="label" for="browser-theme-mode"><%= gettext("Appearance") %></label>
        </div>
        <div class="field-body">
          <div class="field">
            <div class="control">
              <div
                class="select is-fullwidth"
                id="theme-selector"
                phx-hook="ThemeSelector"
                phx-update="ignore"
              >
                <select id="browser-theme-mode" data-theme-mode-select>
                  <option value="system"><%= gettext("Follow System") %></option>
                  <option value="light"><%= gettext("Light") %></option>
                  <option value="dark"><%= gettext("Dark") %></option>
                </select>
              </div>
            </div>
            <p class="help">仅保存到当前浏览器。首次访问跟随设备系统，顶部按钮可随时切换。</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="columns is-mobile is-centered settings-layout">
    <div class="column">
      <h2 class="title is-4"><%= gettext("Units") %></h2>
      <div class="field is-horizontal">
        <div class="field-label is-normal">
          <%= label(f, :unit_of_length, gettext("Length"), class: "label") %>
        </div>
        <div class="field-body">
          <div class="field">
            <div class="control">
              <div class="select is-fullwidth">
                <%= select(f, :unit_of_length, [:km, :mi]) %>
              </div>
            </div>
            <p class="help is-danger"><%= error_tag(f, :unit_of_length) %></p>
          </div>
        </div>
      </div>
      <div class="field is-horizontal">
        <div class="field-label is-normal">
          <%= label(f, :unit_of_temperature, gettext("Temperature"), class: "label") %>
        </div>
        <div class="field-body">
          <div class="field">
            <div class="control">
              <div class="select is-fullwidth">
                <%= select(f, :unit_of_temperature, "°C": :C, "°F": :F) %>
              </div>
            </div>
            <p class="help is-danger"><%= error_tag(f, :unit_of_temperature) %></p>
          </div>
        </div>
      </div>
      <div class="field is-horizontal">
        <div class="field-label is-normal">
          <%= label(f, :unit_of_pressure, gettext("Tire Pressure"), class: "label") %>
        </div>
        <div class="field-body">
          <div class="field">
            <div class="control">
              <div class="select is-fullwidth">
                <%= select(f, :unit_of_pressure, [:bar, :psi]) %>
              </div>
            </div>
            <p class="help is-danger"><%= error_tag(f, :unit_of_pressure) %></p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="columns is-mobile is-centered settings-layout">
    <div class="column">
      <h2 class="title is-4"><%= gettext("URLs") %></h2>
      <div class="field is-horizontal center-vertically">
        <div class="field-label is-normal">
          <%= label(f, :base_url, gettext("Web App"), class: "label") %>
        </div>
        <div class="field-body">
          <div class="field">
            <div class="control">
              <%= text_input(f, :base_url,
                type: :url,
                class: "input",
                phx_debounce: "blur",
                placeholder: "teslamate.example.com"
              ) %>
            </div>
            <p class="help is-danger"><%= error_tag(f, :base_url) %></p>
          </div>
        </div>
      </div>

      <div class="field is-horizontal center-vertically">
        <div class="field-label is-normal">
          <%= label(f, :grafana_url, gettext("Dashboards"), class: "label") %>
        </div>
        <div class="field-body">
          <div class="field">
            <div class="control">
              <%= text_input(f, :grafana_url,
                type: :url,
                class: "input",
                phx_debounce: "blur",
                placeholder: "grafana.example.com"
              ) %>
            </div>
            <p class="help is-danger"><%= error_tag(f, :grafana_url) %></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</.form>

<section class="columns is-mobile is-centered settings-layout" id="map-settings">
  <div class="column">
    <h2 class="title is-4">地图</h2>
    <p class="help mb-4" id="map-settings-current">
      当前使用：<%= if @map_preferences.provider == :amap, do: "高德地图", else: "OpenStreetMap" %>。
      用于首页实时位置、行车仪表盘和行程轨迹，地图颜色跟随页面深浅色模式。
    </p>
    <.form
      :let={f}
      for={@map_form}
      as={:map_settings}
      id="map-settings-form"
      phx-change="map_draft"
      phx-submit="save_map_settings"
      autocomplete="off"
    >
      <div class="field">
        <%= label(f, :provider, "地图提供商", class: "label") %>
        <div class="control">
          <div class="select is-fullwidth">
            <%= select(f, :provider, [
              {"高德地图（国内推荐）", "amap"},
              {"OpenStreetMap（无需 Key）", "openstreetmap"}
            ]) %>
          </div>
        </div>
        <p :for={error <- Map.get(@map_errors, :provider, [])} class="help is-danger">
          <%= error %>
        </p>
      </div>
      <div :if={@map_form["provider"] == "amap"} id="amap-credentials">
        <div class="field">
          <%= label(f, :amap_key, "高德 Web 端（JS API）Key", class: "label") %>
          <div class="control">
            <%= password_input(f, :amap_key,
              value: @map_form["amap_key"] || "",
              class: "input",
              autocomplete: "new-password",
              maxlength: 128,
              phx_debounce: "300",
              placeholder:
                if(@map_preferences.has_amap_key, do: "已保存，留空保留", else: "请输入高德 Web 端 Key")
            ) %>
          </div>
          <p :for={error <- Map.get(@map_errors, :amap_key, [])} class="help is-danger">
            <%= error %>
          </p>
        </div>
        <div class="field">
          <%= label(f, :amap_security_code, "高德安全密钥（securityJsCode）", class: "label") %>
          <div class="control">
            <%= password_input(f, :amap_security_code,
              value: @map_form["amap_security_code"] || "",
              class: "input",
              autocomplete: "new-password",
              maxlength: 128,
              phx_debounce: "300",
              placeholder:
                if(@map_preferences.has_amap_security_code, do: "已保存，留空保留", else: "请输入配套安全密钥")
            ) %>
          </div>
          <p :for={error <- Map.get(@map_errors, :amap_security_code, [])} class="help is-danger">
            <%= error %>
          </p>
        </div>
        <p class="help mb-4">
          在
          <a href="https://console.amap.com/dev/key/app" target="_blank" rel="noopener noreferrer">
            高德开放平台
          </a>
          创建 Web 端（JS API）Key，并把本站域名加入白名单。安全密钥加密保存，已保存的密钥不会回显。
          如需更换 Key，请同时填写与之配套的安全密钥。
        </p>
      </div>
      <p :if={@map_form["provider"] == "openstreetmap"} class="help mb-4">
        无需 Key，国内网络可能无法加载地图。
      </p>
      <div class="map-settings-actions">
        <button type="submit" class="button is-primary" phx-disable-with="正在保存…">
          保存并应用
        </button>
        <span class="help">选择提供商或输入 Key 后，点击保存才会应用。</span>
      </div>
    </.form>
  </div>
</section>

<div class="columns is-mobile is-centered settings-layout">
  <div class="column is-narrow table-container">
    <table class="about table is-narrow">
      <tbody>
        <tr>
          <th align="right"><%= gettext("Version") %></th>
          <td>
            <%= Application.spec(:teslamate, :vsn) %><strong><%= if @update do
                  vsn = link @update, to: TeslaMate.Updater.releases_url(),
                                      target: "_blank", rel: "noopener noreferrer"

                  [" (", gettext("Update available"), ": ", vsn, ")"]
                end %></strong>
          </td>
        </tr>
        <tr>
          <th align="right"><%= gettext("GitHub") %></th>
          <td>
            <%= link("kafuunochino/teslamate",
              to: "https://github.com/kafuunochino/teslamate",
              target: "_blank",
              rel: "noopener noreferrer"
            ) %>
          </td>
        </tr>
        <tr>
          <th align="right"><%= gettext("Project updates") %></th>
          <td>
            <button
              id="check-project-update"
              type="button"
              class={["button", "is-small", if(@repository_check == :checking, do: "is-loading")]}
              phx-click="check_repository_update"
              disabled={@repository_check == :checking}
            >
              <%= gettext("Check for updates") %>
            </button>

            <p class="help">仅检查本项目，不会自动安装更新。</p>

            <%= case @repository_check do %>
              <% :idle -> %>
              <% :checking -> %>
                <p class="help"><%= gettext("Checking for updates…") %></p>
              <% {:ok,
                   %TeslaMate.Updater.RepositoryCheck{
                     status: :current,
                     remote_revision: revision
                   }} -> %>
                <p class="help is-success">
                  <%= gettext("Already up to date (%{revision})",
                    revision: String.slice(revision, 0, 8)
                  ) %>
                </p>
              <% {:ok,
                   %TeslaMate.Updater.RepositoryCheck{
                     status: :update_available,
                     remote_revision: revision,
                     compare_url: compare_url
                   }} -> %>
                <p class="help is-warning">
                  <%= gettext("Project differences found (%{revision})",
                    revision: String.slice(revision, 0, 8)
                  ) %>
                  <%= link(gettext("View changes"),
                    to: compare_url,
                    target: "_blank",
                    rel: "noopener noreferrer"
                  ) %>
                </p>
              <% {:ok, %TeslaMate.Updater.RepositoryCheck{status: :ahead}} -> %>
                <p class="help is-success">当前版本已包含主分支，并包含额外修复。</p>
              <% {:ok,
                   %TeslaMate.Updater.RepositoryCheck{
                     status: :diverged,
                     compare_url: compare_url
                   }} -> %>
                <p class="help is-warning">
                  当前版本与主分支各有改动，需先合并并验证兼容性。 <%= link(gettext("View changes"),
                    to: compare_url,
                    target: "_blank",
                    rel: "noopener noreferrer"
                  ) %>
                </p>
              <% {:error, :unknown_current_revision} -> %>
                <p class="help is-danger">
                  <%= gettext("Current source revision is unknown; rebuild from a Git checkout") %>
                </p>
              <% {:error, _reason} -> %>
                <p class="help is-danger">
                  <%= gettext("Update check failed; please try again later") %>
                </p>
            <% end %>
          </td>
        </tr>
        <tr>
          <th align="right"><%= gettext("Documentation") %></th>
          <td>
            <%= link("docs.teslamate.org",
              to: "https://docs.teslamate.org",
              target: "_blank",
              rel: "noopener noreferrer"
            ) %>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<%= if TeslaMate.Api.signed_in?() and not TeslaMate.Import.enabled?() do %>
  <div class="columns is-mobile is-centered settings-layout">
    <div class="column is-narrow table-container">
      <button
        class="button is-text is-rounded"
        aria-label={gettext("Sign out")}
        phx-click="sign_out"
      >
        <%= gettext("Sign out") %>
      </button>
    </div>
  </div>
<% end %>

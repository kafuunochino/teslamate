          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  d.start_date AS \"开始时间\",\n  COALESCE(sg.name, sa.name, NULLIF(CONCAT_WS(' ', sa.road, sa.house_number), ''), sa.city, '未知地点') AS \"起点\",\n  COALESCE(eg.name, ea.name, NULLIF(CONCAT_WS(' ', ea.road, ea.house_number), ''), ea.city, '未知地点') AS \"终点\",\n  convert_km(d.distance::numeric, '$length_unit') AS distance_$length_unit,\n  ROUND(d.duration_min::numeric, 0) AS \"时长（分钟）\",\n  convert_km(d.speed_max::numeric, '$length_unit') AS speed_$length_unit\nFROM drives d\nLEFT JOIN addresses sa ON sa.id = d.start_address_id\nLEFT JOIN addresses ea ON ea.id = d.end_address_id\nLEFT JOIN geofences sg ON sg.id = d.start_geofence_id\nLEFT JOIN geofences eg ON eg.id = d.end_geofence_id\nWHERE d.car_id = $car_id AND d.end_date IS NOT NULL AND $__timeFilter(d.start_date)\nORDER BY d.start_date DESC\nLIMIT 10;",

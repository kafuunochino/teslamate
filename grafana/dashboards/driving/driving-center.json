          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  COALESCE(g.name, a.name, NULLIF(CONCAT_WS(' ', a.road, a.house_number), ''), a.city, '未知地点') AS \"目的地\",\n  COUNT(*) AS \"到访次数\",\n  convert_km(SUM(d.distance)::numeric, '$length_unit') AS distance_$length_unit\nFROM drives d\nLEFT JOIN addresses a ON a.id = d.end_address_id\nLEFT JOIN geofences g ON g.id = d.end_geofence_id\nWHERE d.car_id = $car_id AND d.end_date IS NOT NULL AND $__timeFilter(d.start_date)\nGROUP BY 1\nORDER BY 2 DESC\nLIMIT 10;",

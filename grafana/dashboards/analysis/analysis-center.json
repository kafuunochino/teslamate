          "rawSql": "SELECT\n  COALESCE(g.name, a.name, NULLIF(CONCAT_WS(' ', a.road, a.house_number), ''), a.city, '未知地点') AS \"充电站\",\n  COUNT(*) AS \"充电次数\",\n  ROUND(SUM(cp.charge_energy_added)::numeric, 1) AS \"累计电量（千瓦时）\",\n  ROUND(SUM(tm_effective_cost(cp.id, cp.cost))::numeric, 2) AS \"累计费用（元）\",\n  ROUND((SUM(tm_effective_cost(cp.id, cp.cost)) / NULLIF(SUM(cp.charge_energy_added), 0))::numeric, 3) AS \"每度电费用（元）\"\nFROM charging_processes cp\nLEFT JOIN addresses a ON a.id = cp.address_id\nLEFT JOIN geofences g ON g.id = cp.geofence_id\nWHERE cp.car_id = $car_id AND cp.end_date IS NOT NULL AND $__timeFilter(cp.start_date)\nGROUP BY 1\nORDER BY 3 DESC\nLIMIT 10;",

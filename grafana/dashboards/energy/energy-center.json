          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  ROUND(convert_celsius(outside_temp_avg, '$temp_unit')::numeric / 5, 0) * 5 AS \"车外温度\",\n  COUNT(*) AS \"行程数\",\n  convert_km(SUM(distance)::numeric, '$length_unit') AS distance_$length_unit,\n  ROUND((\n    SUM((start_[[preferred_range]]_range_km - end_[[preferred_range]]_range_km) * c.efficiency)\n    / NULLIF(convert_km(SUM(distance)::numeric, '$length_unit'), 0) * 1000\n  )::numeric, 1) AS consumption_$length_unit\nFROM drives d\nJOIN cars c ON c.id = d.car_id\nWHERE d.car_id = $car_id AND d.end_date IS NOT NULL AND outside_temp_avg IS NOT NULL\n  AND d.start_[[preferred_range]]_range_km > d.end_[[preferred_range]]_range_km\n  AND $__timeFilter(d.start_date)\nGROUP BY 1\nORDER BY 1;",

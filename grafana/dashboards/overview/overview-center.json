          "rawSql": "SELECT battery_level\nFROM (\n  (SELECT date, battery_level\n   FROM positions\n   WHERE car_id = $car_id AND battery_level IS NOT NULL\n   ORDER BY date DESC LIMIT 1)\n  UNION ALL\n  (SELECT c.date, c.battery_level\n   FROM charges c\n   JOIN charging_processes cp ON cp.id = c.charging_process_id\n   WHERE cp.car_id = $car_id AND c.battery_level IS NOT NULL\n   ORDER BY c.date DESC LIMIT 1)\n) latest\nORDER BY date DESC\nLIMIT 1;",

          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT state\nFROM (\n  SELECT start_date, CASE state\n    WHEN 'asleep' THEN 'asleep'\n    WHEN 'online' THEN 'online'\n    WHEN 'offline' THEN 'offline'\n    ELSE 'unknown'\n  END AS state\n  FROM states\n  WHERE car_id = $car_id\n  UNION ALL\n  SELECT start_date, 'driving' AS state\n  FROM drives\n  WHERE car_id = $car_id AND end_date IS NULL\n  UNION ALL\n  SELECT start_date, 'charging' AS state\n  FROM charging_processes\n  WHERE car_id = $car_id AND end_date IS NULL\n) activity\nORDER BY start_date DESC\nLIMIT 1;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "当前状态",
      "type": "stat"

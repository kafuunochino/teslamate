          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  cp.start_date AS \"开始时间\",\n  COALESCE(g.name, a.name, NULLIF(CONCAT_WS(' ', a.road, a.house_number), ''), a.city, '未知地点') AS \"充电地点\",\n  cp.start_battery_level AS \"开始电量\",\n  cp.end_battery_level AS \"结束电量\",\n  ROUND(cp.charge_energy_added::numeric, 1) AS \"充入电量（千瓦时）\",\n  ROUND(tm_effective_cost(cp.id, cp.cost)::numeric, 2) AS \"费用（元）\",\n  ROUND(cp.duration_min::numeric, 0) AS \"时长（分钟）\"\nFROM charging_processes cp\nLEFT JOIN addresses a ON a.id = cp.address_id\nLEFT JOIN geofences g ON g.id = cp.geofence_id\nWHERE cp.car_id = $car_id AND cp.end_date IS NOT NULL AND $__timeFilter(cp.start_date)\nORDER BY cp.start_date DESC\nLIMIT 10;",
          "refId": "A",
